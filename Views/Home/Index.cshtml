@model IEnumerable<_301301555_301287005_Laylay_Muhammad__Lab3.Models.Movie>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Discover Amazing Movies</h1>
    <div class="search-bar mb-4">
        <div class="input-group">
            <input type="text" id="searchQuery" placeholder="Search by name" class="form-control" />
            <button id="searchButton" class="btn btn-primary">Search</button>
        </div>

        <div class="row mt-2">
            <div class="col-auto">
                <select id="genreSelect" class="form-select">
                    <option value="">Select Genre</option>
                    <option value="Action">Action</option>
                    <option value="Comedy">Comedy</option>
                    <option value="Drama">Drama</option>
                    <option value="Horror">Horror</option>
                    <option value="Science Fiction">Science Fiction</option>
                    <!-- Add more genres as needed -->
                </select>
            </div>
            <div class="col-auto">
                <input type="number" id="ratingQuery" placeholder="Min Rating" class="form-control" min="0" step="0.1" />
            </div>
            <div class="col-auto">
                <button id="genreButton" class="btn btn-secondary">Search by Genre</button>
            </div>
            <div class="col-auto">
                <button id="ratingButton" class="btn btn-success">Search by Rating</button>
            </div>
        </div>

    </div>

    <h2>Top Rated Movies</h2>
    <div id="topRatedMovies" class="row">
        @foreach (var movie in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <a href="@Url.Action("Movie", new { movieId = movie.MovieId })">
                        <img src="@movie.BannerImageHref" class="card-img-top" alt="@movie.Title" />
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>
                        <p class="card-text">Rating: @movie.Rating</p>
                        <p class="card-text">Genre: @movie.Genre</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
