@model _301301555_301287005_Laylay_Muhammad__Lab3.Models.Movie

<div class="movie-details">
    <h1>@Model.Title</h1>
    <video controls style="width: 100%; max-width: 800px; height: auto;">
        <source src="@ViewBag.MovieUrl" type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <div class="input-group mt-3">
        <input type="number" id="rating" placeholder="Rate this movie" class="form-control" min="0" step="0.1" style="max-width: 100px;" />
        <button id="addRatingButton" class="btn btn-primary">Add Rating</button>
        <button id="addRatingButton" class="btn btn-primary">Add Comment</button>
    </div>

    <section class="mt-3">
        <h3>Comments:</h3>
        @if (!Model.Comments.Any())
        {
            <p>No comments present.</p>
        }
        else{
            <ul id="commentList">
                @if (!Model.Comments.Any())
                {
                    <li>No comments present.</li>
                }
                else
                {
                    foreach (var comment in Model.Comments)
                    {
                        <li>
                            @comment.Content
                            <span>Posted at: @comment.PostedAt.ToLocalTime()</span>
                            @if (comment.PostedAt > DateTime.UtcNow.AddHours(-24)) // Check if within 24 hours
                            {
                                <button class="btn btn-warning btn-sm" onclick="editComment('@comment.CommentId')">Edit</button>
                            }
                        </li>
                    }
                }
            </ul>                        
        }
    </section>
 

</div>