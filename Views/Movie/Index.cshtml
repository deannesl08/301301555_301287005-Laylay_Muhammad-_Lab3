@model _301301555_301287005_Laylay_Muhammad__Lab3.Models.Movie

<div class="movie-details">
    @if (ViewData["MovieNotFound"] != null)
    {
        <div class="text-center">
            Movie no longer available.
        </div>
    }
    else
    {
        <h1>@Model.Title</h1>

        @if (ViewData.ModelState["rating"] != null)
        {
            <div class="toast align-items-center text-white bg-danger border-0 m-toast-fixed" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        @ViewData.ModelState["rating"].Errors[0].ErrorMessage
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }

        <video controls style="width: 100%; height: auto;">
            <source src="@ViewBag.MovieUrl" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <div class="d-flex justify-content-between mt-3">
            <form method="post" action="/Movie/AddRating">
                <div class="input-group">
                    <select name="rating" class="form-select" style="max-width: 150px;">
                        <option value="">Select a rating</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                    <input type="hidden" name="movieId" value="@Model.MovieId" />
                    <button type="submit" class="btn btn-primary">Add Rating</button>
                </div>
            </form>
            <button id="downloadMovieButton" type="button" class="btn btn-primary ms-auto">Download</button>
        </div>

        <div class="comment-section d-flex flex-column mt-3">
            <textarea id="commentContent" rows="3" placeholder="Add a comment..." class="form-control" style="resize: none;"></textarea>
            <button id="addCommentButton" class="btn btn-primary mt-2 ms-auto">Add Comment</button>
        </div>

        <section class="mt-3">
            <h3>Comments:</h3>
            <ul id="commentList">
                @if (!Model.Comments.Any())
                {
                    <li>No comments present.</li>
                }
                else
                {
                    foreach (var comment in Model.Comments)
                    {
                        <li>
                            @comment.Content
                            <span>Posted at: @comment.PostedAt.ToLocalTime()</span>
                            @if (comment.PostedAt > DateTime.UtcNow.AddHours(-24)) 
                            {
                                <button class="btn btn-warning btn-sm" onclick="editComment('@comment.CommentId')">Edit</button>
                            }
                        </li>
                    }
                }
            </ul>                        
        </section>
    }
</div>

<script>
    document.getElementById("addCommentButton").addEventListener("click", function () {
        const content = document.getElementById("commentContent").value;
        const movieId = "@Model.MovieId";
        fetch(`/Home/AddComment?movieId=${movieId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ content })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert("Failed to add comment.");
                }
            });
    });

</script>
